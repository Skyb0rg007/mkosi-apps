[Exec]
Boot=true
ResolvConf=bind-uplink
Timezone=bind
Parameters= \
    systemd.set_credential=passwd.plaintext-password.root: \
    systemd.set_credential=tty.serial.hvc0.agetty.autologin:root \
    systemd.set_credential=tty.serial.hvc0.login.noauth:yes \
    systemd.set_credential=tty.console.agetty.autologin:root \
    systemd.set_credential=tty.console.login.noauth:yes \
    systemd.set_credential=tty.virtual.tty1.agetty.autologin:root \
    systemd.set_credential=tty.virtual.tty1.login.noauth:yes \

# No Volatile=: it discards app state on every container restart.
# BindReadOnly= is privileged, so it only applies from /etc/systemd/nspawn/.
[Files]
# BindReadOnly=mkosi.output/debug-sysext:/run/extensions/debug-sysext

# No [Network] section: nspawn ignores all of it from a file next to the image
# ("not trusted"). Rootless, pass --network-veth or --private-network instead;
# Bridge= needs privileges either way.
