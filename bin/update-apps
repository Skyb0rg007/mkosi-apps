    # shellcheck disable=SC2016 # mkosi.sync's keys, $version and all
    victoria VictoriaMetrics/VictoriaMetrics \
        'victoria-metrics-linux-amd64-v$version.tar.gz' \
        'vmutils-linux-amd64-v$version.tar.gz'
}

update_wakapi() {
    github_app muety/wakapi "" wakapi_linux_amd64.zip
}

update_woodpecker() {
    latest="$(github_latest woodpecker-ci/woodpecker)"
    if pick "$latest"; then
        base="https://github.com/woodpecker-ci/woodpecker/releases/download/v$new"
        fetch "$base/checksums.txt" > "$tmp/checksums.txt"
        for archive in woodpecker-server_linux_amd64.tar.gz woodpecker-agent_linux_amd64.tar.gz; do
            upstream="$(awk -v name="$archive" '$2 == name { print $1 }' "$tmp/checksums.txt")"
            [ -n "$upstream" ] || die "$archive: not in upstream's checksums.txt"
            sum="$(download "$base/$archive" "$tmp/$archive" "$upstream")"
            set_pin mkosi.sync "$archive" "$sum"
        done
    fi

    plugin_git="$(github_latest woodpecker-ci/plugin-git)"
    [ -n "$plugin_git" ] || die "found no plugin-git release upstream"
    if newer "$(get_var mkosi.sync plugin_git_version)" "$plugin_git"; then
        log "updating plugin-git to $plugin_git"
        digest="$(github_digest woodpecker-ci/plugin-git "$plugin_git" linux-amd64_plugin-git)"
        sum="$(download "https://github.com/woodpecker-ci/plugin-git/releases/download/$plugin_git/linux-amd64_plugin-git" "$tmp/plugin-git" "$digest")"
        set_var mkosi.sync plugin_git_version "$plugin_git"
        set_var mkosi.sync plugin_git_sha256 "$sum"
    fi
}

# Run in the app's profile directory: update it, and set its version, from
# what changed.
update() {
    cur="$(cat mkosi.version)"
    cur_ver="${cur%-*}"
    cur_rev="${cur##*-}"
    new="$cur_ver"
    for file in mkosi.sync requirements.lock; do
        if [ -e "$file" ]; then
            cp "$file" "$tmp/$file.orig"
        fi
    done

    "update_$app"

    changed=
    for file in mkosi.sync requirements.lock; do
        if [ -e "$file" ] && ! cmp -s "$file" "$tmp/$file.orig"; then
            changed=1
        fi
    done
    if [ "$new" != "$cur_ver" ]; then
        version="$new-1"
    elif [ -n "$changed" ]; then
        version="$cur_ver-$((cur_rev + 1))"
    else
        log "up to date at $cur"
        return
    fi
    echo "$version" > mkosi.version
    log "updated from $cur to $version"
}

if [ $# = 0 ]; then
    for file in mkosi.profiles/*/mkosi.version; do
        set -- "$@" "$(basename "$(dirname "$file")")"
    done
fi

updated=
failed=
for arg; do
    app="${arg%%=*}"
    override=
    if [ "$arg" != "$app" ]; then
        override="${arg#*=}"
    fi
    if [ ! -e "mkosi.profiles/$app/mkosi.version" ] || ! command -v "update_$app" > /dev/null; then
        log "not an app this can update"
        failed="$failed $app"
        continue
    fi
    before="$(cat "mkosi.profiles/$app/mkosi.version")"
    # In a subshell, so that a failure leaves the other apps to go on; set -e
    # does not hold in one that is a condition, hence the status.
    set +e
    (
        set -e
        cd "mkosi.profiles/$app"
        tmp="$(mktemp -d)"
        trap 'rm -rf "$tmp"' EXIT
        update
    )
    status=$?
    set -e
    if [ "$status" != 0 ]; then
        failed="$failed $app"
    elif [ "$(cat "mkosi.profiles/$app/mkosi.version")" != "$before" ]; then
        updated="$updated $app"
    fi
done

echo
echo "Updated:${updated:- none}"
if [ -n "$failed" ]; then
    echo "Failed:$failed"
    exit 1
fi
if [ -n "$updated" ]; then
    echo "Build and try each, with mkosi -f --profile=<app> build, then commit."
fi
