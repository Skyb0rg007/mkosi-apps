[Unit]
Description=Homebox
Documentation=https://homebox.software/
After=network.target
After=homebox-secret.service
Requires=homebox-secret.service

[Service]
ExecStart=/usr/bin/homebox
User=homebox
Group=homebox
StateDirectory=homebox
WorkingDirectory=/var/lib/homebox
Environment=HBOX_MODE=production
Environment=HBOX_WEB_PORT=3000
Environment=HBOX_STORAGE_CONN_STRING=file:///var/lib/homebox
Environment=HBOX_STORAGE_PREFIX_PATH=uploads
Environment=HBOX_DATABASE_SQLITE_PATH=/var/lib/homebox/homebox.db?_pragma=busy_timeout=999&_pragma=journal_mode=WAL&_fk=1&_time_format=sqlite
EnvironmentFile=-/etc/homebox.conf
EnvironmentFile=/var/lib/homebox-secret/secret.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
