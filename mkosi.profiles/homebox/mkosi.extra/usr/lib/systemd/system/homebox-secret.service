[Unit]
Description=Homebox Secret Generation
Before=homebox.service
ConditionPathExists=!/var/lib/homebox-secret/secret.env

[Service]
Type=oneshot
UMask=0077
# State, not configuration: the pepper must survive a volatile or read-only
# /etc, or every API key stops validating when it is regenerated.
StateDirectory=homebox-secret
StateDirectoryMode=0700
WorkingDirectory=/var/lib/homebox-secret
ExecStart=/bin/sh -c '{ printf "HBOX_AUTH_API_KEY_PEPPER="; openssl rand -base64 48; } > secret.env.tmp && mv secret.env.tmp secret.env'

[Install]
WantedBy=multi-user.target
RequiredBy=homebox.service
