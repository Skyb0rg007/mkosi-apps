# CDash's settings, as Laravel environment variables, which /etc/cdash.conf
# overrides. The secret APP_KEY is in /var/lib/cdash-secret/secret.env.
APP_ENV=production
APP_DEBUG=false
# The URL CDash puts in its links and emails.
APP_URL=http://cdash._dhcp
# The local PostgreSQL from postgresql-setup@cdash.service, over its socket
# with peer authentication.
DB_HOST=/run/postgresql
DB_DATABASE=cdash
DB_USERNAME=cdash
DB_PASSWORD=
# Into the journal, under the unit that logs, rather than storage/logs.
LOG_CHANNEL=syslog
