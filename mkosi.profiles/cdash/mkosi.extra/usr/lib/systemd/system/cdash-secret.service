[Unit]
Description=CDash Secret Generation
ConditionPathExists=!/var/lib/cdash-secret/secret.env

[Service]
Type=oneshot
UMask=0077
# State, not configuration: Laravel's application key encrypts and signs
# sessions and cookies.
StateDirectory=cdash-secret
StateDirectoryMode=0700
WorkingDirectory=/var/lib/cdash-secret
ExecStart=/bin/sh -c '{ printf "APP_KEY=base64:"; openssl rand -base64 32; } > secret.env.tmp && mv secret.env.tmp secret.env'
