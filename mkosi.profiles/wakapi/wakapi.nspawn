# Settings for systemd-nspawn@wakapi.service, installed as
# /etc/systemd/nspawn/wakapi.nspawn. The machine is
# /var/lib/machines/wakapi.mstack/; see "Running as a system service" in the
# README.
[Exec]
# .mstack/ machines require a user namespace from systemd-nsresourced.
PrivateUsers=managed
ResolvConf=bind-uplink
Timezone=bind
# The root is read-only, so a stable machine ID has to come from here. Set one
# per host from systemd-id128 new.
#MachineID=

[Network]
VirtualEthernet=yes
