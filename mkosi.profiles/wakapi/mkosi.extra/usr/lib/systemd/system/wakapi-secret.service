[Unit]
Description=Wakapi Secret Generation
Before=wakapi.service
ConditionPathExists=!/var/lib/wakapi-secret/secret.env

[Service]
Type=oneshot
UMask=0077
# State, not configuration: every password hash depends on the salt, and every
# session on the cookie key, so both must survive upgrades.
StateDirectory=wakapi-secret
StateDirectoryMode=0700
WorkingDirectory=/var/lib/wakapi-secret
ExecStart=/bin/sh -c '{ printf "WAKAPI_PASSWORD_SALT="; openssl rand -base64 48; printf "WAKAPI_COOKIE_KEY="; openssl rand -base64 48; } > secret.env.tmp && mv secret.env.tmp secret.env'

[Install]
WantedBy=multi-user.target
RequiredBy=wakapi.service
