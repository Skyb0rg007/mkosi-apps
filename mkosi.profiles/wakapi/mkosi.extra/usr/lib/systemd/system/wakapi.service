[Unit]
Description=Wakapi
Documentation=https://github.com/muety/wakapi
After=network.target
After=wakapi-secret.service
Requires=wakapi-secret.service

[Service]
DynamicUser=yes
StateDirectory=wakapi
# Wakapi reads config.yml from here if it exists; there is none, so it runs
# from the defaults and the environment.
WorkingDirectory=/var/lib/wakapi
ExecStart=/usr/bin/wakapi
Environment=ENVIRONMENT=production
# One dual-stack listener on port 80, instead of separate IPv4 and IPv6 ones on
# localhost.
Environment=WAKAPI_LISTEN_IPV4=-
Environment=WAKAPI_LISTEN_IPV6=::
Environment=WAKAPI_PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=WAKAPI_DB_TYPE=sqlite3
Environment=WAKAPI_DB_NAME=/var/lib/wakapi/wakapi.db
# Served in plain HTTP; behind an HTTPS proxy, set this to false.
Environment=WAKAPI_INSECURE_COOKIES=true
# Last, so that it can also set the secrets, e.g. those of an existing
# instance.
EnvironmentFile=/var/lib/wakapi-secret/secret.env
EnvironmentFile=-/etc/wakapi.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
