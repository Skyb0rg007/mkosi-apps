# The image's paths, for all of paperless-ngx's services and paperless-manage.
# Settings that are meant to change go in /etc/paperless.conf instead, which
# the environment would override.
PAPERLESS_DATA_DIR=/var/lib/paperless/data
PAPERLESS_MEDIA_ROOT=/var/lib/paperless/media
PAPERLESS_CONSUMPTION_DIR=/var/lib/paperless/consume
PAPERLESS_STATICDIR=/usr/lib/paperless-ngx/static
# /usr is read-only, and its bytecode compiled already.
PYTHONDONTWRITEBYTECODE=1
