#!/bin/sh
# Download Immich's server as upstream builds it, with what it runs on.
# Upstream publishes the server only as a container image, on Debian trixie,
# whose base image builds libvips, ImageMagick, libheif, libjxl, libraw and
# jpegli itself, into /usr/local/lib, and the server's sharp against them.
# This takes the layers holding those libraries, the geodata and the app from
# it, by digest, and unpacks them into dist/, which the build script installs
# on Debian's own libraries. Node.js is the release binary of the version the
# image has; jellyfin-ffmpeg and VectorChord, for PostgreSQL, are the Debian
# packages of the versions upstream pins, which go into mkosi.packages/.
set -eu

# mkosi passes the invoking shell's umask on; a restrictive one must not
# end up in the images' modes.
umask 022

# Upstream version: mkosi.version without its "-<revision>" suffix. The image
# and layer digests belong to that version, so update them together; the
# others have versions of their own, which upstream's image (Node.js, ffmpeg)
# and docker-compose.yml (VectorChord) pin.
version="$(jq -r .ImageVersion "$MKOSI_CONFIG")"
version="${version%-*}"
node_version=24.22.1
node_sha256=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6
ffmpeg_version=7.1.4-3
ffmpeg_sha256=8e30f9f7f3958c524bec8334540e4241145ad4300b328a08a55783c619187225
vectorchord_version=0.4.3
vectorchord_sha256=a4776ac7b1def6d4f02370227a214be50ec36c84d0af3469070120667215f4ae
registry=https://ghcr.io/v2/immich-app/immich-server
# Of ghcr.io/immich-app/immich-server:v$version for linux/amd64, image
# sha256:c0a8e008ad9befe8af0e3a515e3b3661e98d38c37eadb6efee18a6d5098136c1,
# its configuration, and the layers that upstream's Dockerfiles copy into it,
# in order: the base image's /usr/local/lib, its /build (geodata), its
# ImageMagick policy, the server, the web client, the CLI and the core
# plugin's two. A blob's digest is its checksum.
config=fb0c7c1a1b2a553c1c60e4bbb3d999d3d1483c9a223807e0856cd42d30b9cbea
layers="
e16af751f5278b402c1f3dcb55ab41ffe9de3278918e3da3294b079a6b02943c
a6cabc061cfe9817907e3b5468fccfc58b3d4156a16a8e0926662792e5d9e9f5
d851f06c6d208d34d856cc455316ede53ea6ab1d3cf99b5507e3533c08c078ac
0837ca41ae71bd03f9b13eaf2b4e56c5b9ff10fa30a891d1a44dc55abfe358e0
3a40417a5ed59c02a4d030f813706ca6f8db7b5fe1c519e673dab20d112aac38
00fda094e6571ba0111a450f2b05d46b327ce37ce04c7dec44503b65746e09d2
412f1248827ecbac68095fc1c8690918894a103d738a89ea4096593357d3c04a
fa7d5f12db0b8425fe564ffaa773f947f342c352e4ac7874722be7f738f1bc51
"
stamp="$version node-$node_version"

# mkosi runs this script as /work/sync, so paths must come from $SRCDIR.
TARGET="$SRCDIR/mkosi.profiles/immich/dist"
PACKAGES="$SRCDIR/mkosi.packages"

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

# download FILE SHA256 URL [CURL-OPTION...]
download() {
    file="$1"
    sha256="$2"
    shift 2
    curl --fail --location --output "$file" "$@"
    printf '%s  %s\n' "$sha256" "$file" | sha256sum --check --status
}

# package FILE SHA256 URL: a Debian package, into mkosi.packages/
package() {
    if [ -e "$PACKAGES/$1" ]; then
        echo "immich: $1 exists, skipping"
        return
    fi
    mkdir -p "$PACKAGES"
    download "$tmpdir/$1" "$2" "$3"
    mv "$tmpdir/$1" "$PACKAGES/$1"
}

package "jellyfin-ffmpeg7_${ffmpeg_version}-trixie_amd64.deb" "$ffmpeg_sha256" \
    "https://github.com/jellyfin/jellyfin-ffmpeg/releases/download/v$ffmpeg_version/jellyfin-ffmpeg7_${ffmpeg_version}-trixie_amd64.deb"
package "postgresql-17-vchord_${vectorchord_version}-1_amd64.deb" "$vectorchord_sha256" \
    "https://github.com/tensorchord/VectorChord/releases/download/$vectorchord_version/postgresql-17-vchord_${vectorchord_version}-1_amd64.deb"

if [ "$(cat "$TARGET/.mkosi-version" 2>/dev/null)" = "$stamp" ]; then
    echo "immich: $TARGET is $stamp, skipping download"
    exit
fi

mkdir "$tmpdir/dist" "$tmpdir/layers"
token="$(curl --fail --silent "https://ghcr.io/token?scope=repository:immich-app/immich-server:pull" | jq -r .token)"
download "$tmpdir/config" "$config" "$registry/blobs/sha256:$config" --header="Authorization: Bearer $token"
for digest in $layers; do
    download "$tmpdir/layer" "$digest" "$registry/blobs/sha256:$digest" --header="Authorization: Bearer $token"
    # Plain additions, no whiteouts: each is a COPY.
    tar --extract --gunzip --file="$tmpdir/layer" --directory="$tmpdir/layers"
done

# The versions the image has, which the pins above must match.
image_env() {
    jq -r --arg name "$1" '.config.Env[] | select(startswith($name + "=")) | ltrimstr($name + "=")' "$tmpdir/config"
}
check() {
    if [ "$2" != "$3" ]; then
        echo "immich: the image has $1 $3, but this pins $2" >&2
        exit 1
    fi
}
check Immich "v$version" "$(image_env IMMICH_SOURCE_REF)"
check Node.js "$node_version" "$(image_env NODE_VERSION)"
check jellyfin-ffmpeg "$ffmpeg_version" "$(jq -r '.packages[] | select(.name == "ffmpeg") | .version' "$tmpdir/layers/build/build-lock.json")"

layer="$tmpdir/layers"
mv "$layer/usr/local/lib" "$tmpdir/dist/lib"
mv "$layer/build" "$tmpdir/dist/build"
mv "$layer/etc/ImageMagick/policy.xml" "$tmpdir/dist/policy.xml"
mv "$layer/usr/src/app/server" "$tmpdir/dist/server"
mv "$layer/usr/src/app/cli" "$tmpdir/dist/cli"
# The build's details, as the image has them, which the server shows.
jq -r '.config.Env[] | select(startswith("IMMICH_"))' "$tmpdir/config" > "$tmpdir/dist/version.env"

node="node-v$node_version-linux-x64"
download "$tmpdir/node.tar.xz" "$node_sha256" "https://nodejs.org/dist/v$node_version/$node.tar.xz"
tar --extract --xz --file="$tmpdir/node.tar.xz" --directory="$tmpdir" "$node/bin/node" "$node/LICENSE"
mv "$tmpdir/$node" "$tmpdir/dist/node"

echo "$stamp" > "$tmpdir/dist/.mkosi-version"
rm -rf "$TARGET"
mv "$tmpdir/dist" "$TARGET"
