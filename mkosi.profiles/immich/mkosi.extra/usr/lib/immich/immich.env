# Immich's settings, as environment variables, which /etc/immich.conf
# overrides. The image's build details are in version.env.
NODE_ENV=production
IMMICH_HOST=::
IMMICH_PORT=80
# Uploads, thumbnails, encoded videos and backups.
IMMICH_MEDIA_LOCATION=/var/lib/immich
# The web client, the geodata and the core plugin, from upstream's image.
IMMICH_BUILD_DATA=/usr/lib/immich/build
# Smart search, face recognition and OCR need upstream's machine-learning
# service, which the image does not have.
IMMICH_MACHINE_LEARNING_ENABLED=false
# The local PostgreSQL from postgresql-setup@immich.service, over its socket
# with peer authentication.
DB_HOSTNAME=/run/postgresql
DB_USERNAME=immich
DB_DATABASE_NAME=immich
# The local Redis.
REDIS_HOSTNAME=127.0.0.1
MAGICK_CONFIGURE_PATH=/usr/lib/immich/ImageMagick
