#!/bin/sh
# Build step: offline. Modules come from the cache mkosi.sync filled, served as
# a file:// proxy, and go re-verifies each one against go.sum as it extracts it.
set -eu

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

export GOPROXY="file://$SRCDIR/mkosi.cache/go-mod/cache/download"
export GOMODCACHE="$tmpdir/go-mod"
export GOCACHE="$tmpdir/go-build"
export GOFLAGS="-modcacherw -mod=readonly -tags=libsqlite3"
export GOTOOLCHAIN=local

cd "$SRCDIR/mkosi.profiles/soju/src"

make
make install PREFIX="/usr"

# soju.service uses DynamicUser=, so systemd owns /var/lib/soju; a copy shipped
# in the image only triggers a migration warning on first start.
rmdir "$DESTDIR/var/lib/soju"

# gamja needs no build. Its files come out of the sync step with the checkout's
# umask, so set modes that nginx's www-data can read.
cp -R "$SRCDIR/mkosi.profiles/soju/gamja" "$DESTDIR/usr/share/gamja"
rm "$DESTDIR/usr/share/gamja/.mkosi-version"
find "$DESTDIR/usr/share/gamja" -type d -exec chmod 0755 {} +
find "$DESTDIR/usr/share/gamja" -type f -exec chmod 0644 {} +
