#!/bin/sh
# Fetch step: the only part of the soju build that touches the network.
#
# Downloads and verifies the release tarball, then downloads its Go modules into
# a shared module cache, verified against the go.sum the tarball ships. The
# build script compiles offline from that cache (see mkosi.build.chroot).
# Also downloads gamja with its dependencies, which the build script installs.
set -eu

# Upstream version: mkosi.version without its "-<revision>" suffix. The
# checksum belongs to that version, so update both together.
version="$(jq -r .ImageVersion "$MKOSI_CONFIG")"
version="${version%-*}"
archive="soju-$version.tar.gz"
base_url="https://codeberg.org/emersion/soju/releases/download/v$version"
sha256=78cfb809d6105b797b0af3c837906044a315a90c26e3e6a0bace68f5354c6a8b

TARGET="$SRCDIR/mkosi.profiles/soju/src"
GPG_KEY="$SRCDIR/mkosi.profiles/soju/emersion.gpg"

if ! command -v go >/dev/null; then
    echo "soju: go must be available in the tools tree (ToolsTreePackages=golang-go)"
    exit 1
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

if [ "$(cat "$TARGET/.mkosi-version" 2>/dev/null)" = "$version" ]; then
    echo "soju: $TARGET is $version, skipping download"
else
    curl --fail --location --output "$tmpdir/$archive" "$base_url/$archive"
    curl --fail --location --output "$tmpdir/$archive.sig" "$base_url/$archive.sig"

    if command -v sqop >/dev/null; then
        sqop verify "$tmpdir/$archive.sig" "$GPG_KEY" < "$tmpdir/$archive"
    elif command -v sqv >/dev/null; then
        sqv --keyring "$GPG_KEY" "$tmpdir/$archive.sig" "$tmpdir/$archive"
    elif command -v gpgv >/dev/null && command -v gpg >/dev/null; then
        gpg --dearmor < "$GPG_KEY" > "$tmpdir/emersion.gpg"
        gpgv --homedir=/dev/null --keyring="$tmpdir/emersion.gpg" \
            -- "$tmpdir/$archive.sig" "$tmpdir/$archive"
    else
        echo "soju: no OpenPGP verifier (sqop, sqv or gpgv) available"
        exit 1
    fi

    (
        cd "$tmpdir"
        printf '%s  %s\n' "$sha256" "$archive" | sha256sum --check --status
    )

    # Extract beside the target and move it into place, so an interrupted run
    # never leaves a partial tree that the check above would mistake for done.
    rm -rf "$tmpdir/src"
    mkdir "$tmpdir/src"
    tar --extract --gunzip --file="$tmpdir/$archive" --directory="$tmpdir/src" --strip-components=1
    echo "$version" > "$tmpdir/src/.mkosi-version"
    rm -rf "$TARGET"
    mv "$tmpdir/src" "$TARGET"
fi

# gamja, the web client nginx serves. Its own version: bumping it is an
# image-only change. The release is unsigned, so the checksum is all there is.
gamja_version=1.0.0-beta.11
gamja_archive="gamja-$gamja_version.tar.gz"
gamja_url="https://codeberg.org/emersion/gamja/releases/download/v$gamja_version/$gamja_archive"
gamja_sha256=10c37f254028bbb5b3662c659dec8a099e3ed37b8ec90161e12003b8b8b4c930
GAMJA="$SRCDIR/mkosi.profiles/soju/gamja"

if [ "$(cat "$GAMJA/.mkosi-version" 2>/dev/null)" = "$gamja_version" ]; then
    echo "soju: $GAMJA is $gamja_version, skipping download"
else
    curl --fail --location --output "$tmpdir/$gamja_archive" "$gamja_url"
    (
        cd "$tmpdir"
        printf '%s  %s\n' "$gamja_sha256" "$gamja_archive" | sha256sum --check --status
    )

    rm -rf "$tmpdir/gamja"
    mkdir "$tmpdir/gamja"
    tar --extract --gunzip --file="$tmpdir/$gamja_archive" --directory="$tmpdir/gamja" --strip-components=1

    # gamja runs unbundled from its sources and node_modules/, and its runtime
    # dependencies are plain JavaScript, so there is no build: fetch the ones
    # package-lock.json lists outside devDependencies, checked against the
    # lockfile's integrity hashes, without npm.
    jq -r '.packages | to_entries[]
        | select(.key != "" and (.value.dev | not))
        | [.key, .value.resolved, .value.integrity] | @tsv' \
        "$tmpdir/gamja/package-lock.json" > "$tmpdir/gamja-packages"
    while IFS="$(printf '\t')" read -r path url integrity; do
        case "$integrity" in
        sha512-*) ;;
        *) echo "soju: gamja: $path: unsupported integrity $integrity"; exit 1 ;;
        esac
        sha512="$(printf '%s' "${integrity#sha512-}" | base64 --decode | od -An -v -tx1 | tr -d ' \n')"
        curl --fail --location --output "$tmpdir/package.tgz" "$url"
        printf '%s  %s\n' "$sha512" "$tmpdir/package.tgz" | sha512sum --check --status
        mkdir -p "$tmpdir/gamja/$path"
        tar --extract --gunzip --file="$tmpdir/package.tgz" --directory="$tmpdir/gamja/$path" --strip-components=1
    done < "$tmpdir/gamja-packages"

    echo "$gamja_version" > "$tmpdir/gamja/.mkosi-version"
    rm -rf "$GAMJA"
    mv "$tmpdir/gamja" "$GAMJA"
fi

# Always run: with every module already cached this does no network access,
# and it completes a cache that an earlier run left partial. Downloads are
# checked against go.sum, and the checksum database for anything go.sum does
# not pin; the offline build's -mod=readonly then rejects those.
modcache="$SRCDIR/mkosi.cache/go-mod"
cd "$TARGET"
GOMODCACHE="$modcache" \
    GOCACHE="$tmpdir/go-build" \
    GOFLAGS=-modcacherw \
    GOTOOLCHAIN=local \
    go mod download

# The build only reads cache/download, the proxy layout, and re-extracts from
# it. The extracted trees beside it are several times its size, so drop them.
find "$modcache" -mindepth 1 -maxdepth 1 ! -name cache -exec rm -rf {} +
