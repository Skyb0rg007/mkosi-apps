[Unit]
Description=soju IRC bouncer service
Documentation=https://soju.im/
Documentation=man:soju(1) man:sojuctl(1)
Wants=network-online.target soju-tls-selfsigned.service
After=network-online.target soju-tls-selfsigned.service

[Service]
Type=simple
DynamicUser=yes
StateDirectory=soju
ConfigurationDirectory=soju
RuntimeDirectory=soju
# soju makes /run/soju/http.sock group-writable; the group lets nginx connect.
Group=www-data
# For ident:// on port 113.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# The certificate for /etc/soju/config (see soju-tls-selfsigned.service).
ImportCredential=soju.tls-*
ExecStart=/usr/bin/soju
ExecReload=/usr/bin/kill -HUP $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
