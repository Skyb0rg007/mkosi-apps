# Settings for systemd-nspawn@soju.service, installed as
# /etc/systemd/nspawn/soju.nspawn. The machine is /var/lib/machines/soju.mstack/;
# see "Running as a system service" in the README.
[Exec]
# .mstack/ machines require a user namespace from systemd-nsresourced.
PrivateUsers=managed
ResolvConf=bind-uplink
Timezone=bind
# The root is read-only, so a stable machine ID has to come from here. Set one
# per host from systemd-id128 new.
#MachineID=

[Network]
VirtualEthernet=yes
# /etc/soju/config listens on irc+insecure:// without a port, i.e. 6667.
Port=tcp:6667:6667
# ident: IRC servers query the host, which soju's connections come from.
Port=tcp:113:113
# nginx, serving gamja.
Port=tcp:80:80
