# Template: mkosi.postinst.chroot installs it into /usr/lib/sysupdate.d with
# the URL from $SYSUPDATE_URL. A new version's /usr, into the slot that does not
# hold the booted version.
[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=@SYSUPDATE_URL@/%M/
MatchPattern=%M_@v.usr-%a.@u.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=%M_@v
MatchPartitionType=usr
PartitionFlags=0
ReadOnly=1
