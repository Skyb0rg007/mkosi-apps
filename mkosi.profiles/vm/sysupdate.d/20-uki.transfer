# Template: mkosi.postinst.chroot installs it into /usr/lib/sysupdate.d with
# the URL from $SYSUPDATE_URL. A new version's UKI, whose usrhash= selects its
# /usr, last, so that it only becomes bootable once that is in place. It boots
# with three tries; one that never reaches boot-complete.target falls back to
# the previous version.
[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=@SYSUPDATE_URL@/%M/
MatchPattern=%M_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=%M_@v+@l-@d.efi \
             %M_@v+@l.efi \
             %M_@v.efi
Mode=0644
TriesLeft=3
TriesDone=0
InstancesMax=2
