[Unit]
Description=SearXNG Secret Generation
ConditionPathExists=!/var/lib/searxng-secret/secret.env

[Service]
Type=oneshot
UMask=0077
# State, not configuration: it signs the preferences cookie, and keys the image
# proxy's URLs.
StateDirectory=searxng-secret
StateDirectoryMode=0700
WorkingDirectory=/var/lib/searxng-secret
ExecStart=/bin/sh -c '{ printf "SEARXNG_SECRET="; openssl rand -hex 32; } > secret.env.tmp && mv secret.env.tmp secret.env'
