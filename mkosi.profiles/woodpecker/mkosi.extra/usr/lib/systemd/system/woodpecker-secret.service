[Unit]
Description=Woodpecker Secret Generation
ConditionPathExists=|!/var/lib/woodpecker-secret/secret.env
ConditionPathExists=|!/var/lib/woodpecker-secret/server.env

[Service]
Type=oneshot
UMask=0077
# State, not configuration: agents register with the server under the agent
# secret, and the server signs their tokens with the gRPC one. Only the server
# reads server.env: pipelines run as the agent's user, and can read its
# environment.
StateDirectory=woodpecker-secret
StateDirectoryMode=0700
WorkingDirectory=/var/lib/woodpecker-secret
ExecStart=/bin/sh -c 'set -e; \
        [ -e secret.env ] || { { printf "WOODPECKER_AGENT_SECRET="; openssl rand -hex 32; } > secret.env.tmp && mv secret.env.tmp secret.env; }; \
        [ -e server.env ] || { { printf "WOODPECKER_GRPC_SECRET="; openssl rand -hex 32; } > server.env.tmp && mv server.env.tmp server.env; }'
