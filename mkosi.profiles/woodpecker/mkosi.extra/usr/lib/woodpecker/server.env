# The Woodpecker server's settings in this image. /etc/woodpecker.conf, read
# after this, overrides them, and has to add a forge (see the README), without
# which the server does not start.
# The URL of its web UI, which the forge's OAuth app and webhooks call back.
WOODPECKER_HOST=http://woodpecker._dhcp
# The web UI and API on port 80; agents connect on port 9000.
WOODPECKER_SERVER_ADDR=:80
WOODPECKER_GRPC_ADDR=:9000
WOODPECKER_DATABASE_DRIVER=sqlite3
WOODPECKER_DATABASE_DATASOURCE=/var/lib/woodpecker/woodpecker.sqlite
