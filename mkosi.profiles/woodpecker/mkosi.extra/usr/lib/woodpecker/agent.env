# The local Woodpecker agent's settings in this image. /etc/woodpecker.conf,
# read after this, overrides them.
# Not localhost: the machine has no /etc/hosts, and Go resolves names without
# NSS.
WOODPECKER_SERVER=127.0.0.1:9000
# Steps run as processes in this machine, as the woodpecker-agent user, with
# the image's tools; there is no container engine here.
WOODPECKER_BACKEND=local
WOODPECKER_BACKEND_LOCAL_TEMP_DIR=/var/cache/woodpecker-agent
WOODPECKER_AGENT_CONFIG_FILE=/var/lib/woodpecker-agent/agent.conf
WOODPECKER_HEALTHCHECK=false
