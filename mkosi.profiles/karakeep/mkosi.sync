#!/bin/sh
# Download Karakeep as upstream builds it, with what it runs on: the Node.js
# its container image has, and the Meilisearch its compose file pins. Upstream
# publishes Karakeep only as that container image, whose app is self-contained
# and links nothing but glibc, so this takes the layers holding the app from
# it, by digest, and unpacks them into dist/, which the build script installs.
set -eu

# Upstream version: mkosi.version without its "-<revision>" suffix. The image
# and layer digests belong to that version, so update them together; Node.js
# and Meilisearch have versions of their own, which upstream's Dockerfile and
# docker-compose.yml pin.
version="$(jq -r .ImageVersion "$MKOSI_CONFIG")"
version="${version%-*}"
node_version=24.18.1
node_sha256=d6c664df3f3f61458e8c277585571328522d705166723a7c7823a9253a4d15a0
meilisearch_version=1.41.0
meilisearch_sha256=7c94284f47dcbcb2950f5dcb154c396be7157e16d4f4dd600109f3587247dded
registry=https://ghcr.io/v2/karakeep-app/karakeep
# Of ghcr.io/karakeep-app/karakeep:$version for linux/amd64, image
# sha256:3d57623bf031f32a0597a3ebe0cd869bff6ba181c02ebc90fac492458bcfd4a4,
# the layers that upstream's Dockerfile copies the build into, in order: the
# web app's standalone server in /app, its public/ and .next/static/, the
# database migrations in /db_migrations, the workers, and monolith in
# /usr/local/bin. A layer's digest is its checksum.
layers="
d295fbe5e9d9a559c1a0158b14d1efb80dda808faf5d2733f1e7c45ffda4fe81
0d43fa780f1a5b179e14ffdaa2effc61f0cfdb8b12fe81c508a4711b9a39a773
81761d888e2df25cb696dff24a2f5b90ffa86b11b74101217131b28d2aa9a2e1
13577e0e12c100be6884a1d26168302aa86a8f13d78cef16dd2082de131571ce
7ddfa3d45cd98581bb09ea765322862676d81f2bce3d1a0841fc24b38117a787
e41bf268d01af1ad9f5a6c377112e639d6833be51a03b94eb7603953b680b5dd
"
stamp="$version node-$node_version meilisearch-$meilisearch_version"

# mkosi runs this script as /work/sync, so paths must come from $SRCDIR.
TARGET="$SRCDIR/mkosi.profiles/karakeep/dist"

if [ "$(cat "$TARGET/.mkosi-version" 2>/dev/null)" = "$stamp" ]; then
    echo "karakeep: $TARGET is $stamp, skipping download"
    exit
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
mkdir "$tmpdir/dist" "$tmpdir/layers"

# download FILE SHA256 URL [CURL-OPTION...]
download() {
    file="$1"
    sha256="$2"
    shift 2
    curl --fail --location --output "$file" "$@"
    printf '%s  %s\n' "$sha256" "$file" | sha256sum --check --status
}

token="$(curl --fail --silent "https://ghcr.io/token?scope=repository:karakeep-app/karakeep:pull" | jq -r .token)"
for digest in $layers; do
    download "$tmpdir/layer" "$digest" "$registry/blobs/sha256:$digest" --header="Authorization: Bearer $token"
    # Plain additions, no whiteouts: each is a COPY into an empty directory.
    tar --extract --gunzip --file="$tmpdir/layer" --directory="$tmpdir/layers"
done
mv "$tmpdir/layers/app" "$tmpdir/dist/app"
mv "$tmpdir/layers/db_migrations" "$tmpdir/dist/db_migrations"
mv "$tmpdir/layers/usr/local/bin/monolith" "$tmpdir/dist/monolith"

node="node-v$node_version-linux-x64"
download "$tmpdir/node.tar.xz" "$node_sha256" "https://nodejs.org/dist/v$node_version/$node.tar.xz"
tar --extract --xz --file="$tmpdir/node.tar.xz" --directory="$tmpdir" "$node/bin/node" "$node/LICENSE"
mv "$tmpdir/$node" "$tmpdir/dist/node"

download "$tmpdir/dist/meilisearch" "$meilisearch_sha256" \
    "https://github.com/meilisearch/meilisearch/releases/download/v$meilisearch_version/meilisearch-linux-amd64"

echo "$version" > "$tmpdir/dist/version"
echo "$stamp" > "$tmpdir/dist/.mkosi-version"
rm -rf "$TARGET"
mv "$tmpdir/dist" "$TARGET"
