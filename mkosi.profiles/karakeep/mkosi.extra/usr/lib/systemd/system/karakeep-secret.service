[Unit]
Description=Karakeep Secret Generation
ConditionPathExists=!/var/lib/karakeep-secret/secret.env

[Service]
Type=oneshot
UMask=0077
# State, not configuration: sessions depend on NextAuth's secret, and
# Meilisearch's index on its master key.
StateDirectory=karakeep-secret
StateDirectoryMode=0700
WorkingDirectory=/var/lib/karakeep-secret
ExecStart=/bin/sh -c '{ printf "NEXTAUTH_SECRET="; openssl rand -base64 36; printf "MEILI_MASTER_KEY="; openssl rand -hex 32; } > secret.env.tmp && mv secret.env.tmp secret.env'
