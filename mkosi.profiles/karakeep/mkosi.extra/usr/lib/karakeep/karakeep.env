# Karakeep's settings in this image, for its web app, workers and migrations.
# /etc/karakeep.conf, read after this, overrides them.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
DATA_DIR=/var/lib/karakeep
# On port 80, dual-stack.
HOSTNAME=::
PORT=80
# The URL Karakeep's links and logins use.
NEXTAUTH_URL=http://karakeep._dhcp
NEXTAUTH_URL_INTERNAL=http://localhost
# The local Meilisearch and headless Chromium.
MEILI_ADDR=http://127.0.0.1:7700
BROWSER_WEB_URL=http://127.0.0.1:9222
DB_WAL_MODE=true
LOG_LEVEL=info
OCR_CACHE_DIR=/var/cache/karakeep/ocr
# New releases come with the image.
DISABLE_NEW_RELEASE_CHECK=true
