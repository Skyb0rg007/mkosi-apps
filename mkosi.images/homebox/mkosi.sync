#!/bin/sh
set -eu

cd "$(dirname "$0")"

version=0.26.2
archive=homebox_Linux_x86_64.tar.gz
base_url="https://github.com/sysadminsmedia/homebox/releases/download/v$version"
sha256=078f50ee25de546483d84c0f9ccc587edac6039cde87142fbea39c9ca87dcb05

if [ -e mkosi.extra/usr/bin/homebox ]; then
    echo "homebox: already installed, skipping"
    exit
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

curl --fail --location --output "$tmpdir/$archive" "$base_url/$archive"

printf '%s  %s\n' "$sha256" "$tmpdir/$archive" | sha256sum --check --status

tar --extract --gunzip --file="$tmpdir/$archive" --directory="$tmpdir" homebox

install -D --mode=0755 "$tmpdir/homebox" mkosi.extra/usr/bin/homebox
