[Unit]
Description=Homebox Secret Generation
Before=homebox.service
ConditionPathExists=!/etc/homebox/secret.env

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/mkdir -p /etc/homebox
ExecStart=/bin/sh -c '{ printf "HBOX_AUTH_API_KEY_PEPPER="; openssl rand -base64 48; } > /etc/homebox/secret.env'

[Install]
WantedBy=multi-user.target
RequiredBy=homebox.service
