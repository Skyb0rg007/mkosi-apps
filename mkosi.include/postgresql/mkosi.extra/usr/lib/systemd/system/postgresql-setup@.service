[Unit]
Description=Set up PostgreSQL database %i
Documentation=file:/usr/libexec/postgresql-setup
# Debian's postgresql.service is active once every cluster that existed at boot
# is running; on first boot there is none yet and this creates it.
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/postgresql-setup %i
